# Copy to .env for local development. Never commit a populated .env.
# Generate a persistent random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_PATH=./instance/smart_meds.db
PORT=5000
FLASK_DEBUG=false
RUN_REMINDER_WORKER=false
SMART_MEDS_DEMO_SEED=false

# Optional outbound messaging. No messages are sent until credentials and consent are configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

# Optional external viva expansion. Disabled by default; only non-sensitive project questions may be forwarded.
GEMINI_API_KEY=
VIVA_EXTERNAL_AI_ENABLED=false
